<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VocableTrainer;assembly=VocableTrainer"
             xmlns:sk="clr-namespace:Xamarin.Forms.Skeleton;assembly=Xamarin.Forms.Skeleton"
             x:Class="VocableTrainer.SettingsPageDetail"
             Title="Settings"
             Appearing="SettingsPageDetail_OnAppearing">
    <StackLayout BindingContext="{x:Static local:App.Data}"
                 sk:Skeleton.IsParent="True"
                 sk:Skeleton.IsBusy="{Binding IsBusy}"
                 sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"
                 sk:Skeleton.BackgroundColor="Gray">
        <ActivityIndicator 
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="Fill"/>
        <Label>Vocable database</Label>
        <StackLayout Orientation="Horizontal">
            <Button x:Name="ImportBtn" Text="Import" Clicked="ImportBtn_OnClicked" />
            <Button x:Name="ExportBtn" Text="Export" Clicked="ExportBtn_OnClickedBtn_OnClicked" />
        </StackLayout>

        <Label>Languages</Label>
        <StackLayout Orientation="Horizontal">
            <Button x:Name="EditLang" Text="Edit current" Clicked="EditLang_OnClicked"/>
            <Button x:Name="AddLang" Text="Add new" Clicked="AddLang_OnClicked" />
        </StackLayout>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label VerticalTextAlignment="Center" Grid.Column="0" Text="Play remote control chime" />
            <Switch x:Name="PlayChime" Grid.Column="1" Toggled="PlayChime_OnToggled"/>
        </Grid>
        <!--<Label>Language</Label>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Picker x:Name="Language" Title="" 
                    ItemsSource="{Binding Languages}" 
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding CurrentLanguage}"
                    SelectedIndexChanged="Language_OnSelectedIndexChanged"/>
            <Button Grid.Column="1" x:Name="EditLang" Text="&#9997;" Clicked="EditLang_OnClicked" FontSize="28"/>
        </Grid>-->
       
        <Label>Native voice</Label>
        <Entry x:Name="NativeVoice" TextChanged="NativeVoice_OnTextChanged"/>
        
    </StackLayout>
</ContentPage>