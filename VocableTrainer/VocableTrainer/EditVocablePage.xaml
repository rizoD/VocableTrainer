<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VocableTrainer;assembly=VocableTrainer"
             x:Class="VocableTrainer.EditVocablePage">
    <ContentPage.Content>
        <StackLayout Grid.Row="0">
            <Label>Foreign:</Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Entry Grid.Column="0" x:Name="Foreign" />
                <Button Grid.Column="1" x:Name="PlayForeign" Text="&#128265;" Clicked="PlayForeign_OnClicked" />
            </Grid>
            <Label>Detail:</Label>
            <Entry x:Name="Detail"></Entry>
            <Label>Native:</Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Entry Grid.Column="0" x:Name="Native" />
                <Button Grid.Column="1" x:Name="PlayNative" Text="&#128265;" Clicked="PlayNative_OnClicked" />
            </Grid>
            <Button x:Name="SountBtn" Text="Update Sound" Clicked="SoundBtn_OnClicked"/>
            <StackLayout Orientation="Horizontal">
                <Button x:Name="DelBtn" Text="Delete" Clicked="DelBtn_OnClicked" />
                <Button x:Name="CancelBtn" Text="Cancel" Clicked="CancelBtn_OnClicked" />
                <Button x:Name="OKBtn" Text="OK" Clicked="OKBtn_OnClicked"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>