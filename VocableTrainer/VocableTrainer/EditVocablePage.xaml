<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VocableTrainer;assembly=VocableTrainer"
             x:Class="VocableTrainer.EditVocablePage">
    <ContentPage.Content>
        <StackLayout Grid.Row="0">
            <Label>Foreign:</Label>
            <Entry x:Name="Foreign" />
            <Label>Detail:</Label>
            <Entry x:Name="Detail"></Entry>
            <Label>Native:</Label>
            <Entry x:Name="Native"></Entry>
            <StackLayout Orientation="Horizontal">
                <Button x:Name="DelBtn" Text="Delete" Clicked="DelBtn_OnClicked" />
                <Button x:Name="CancelBtn" Text="Cancel" Clicked="CancelBtn_OnClicked" />
                <Button x:Name="OKBtn" Text="OK" Clicked="OKBtn_OnClicked"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>