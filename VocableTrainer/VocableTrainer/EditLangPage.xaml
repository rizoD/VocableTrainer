<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocableTrainer.EditLangPage">
    <ContentPage.Content>
        <StackLayout Grid.Row="0">
            <Label>Language</Label>
            <Entry x:Name="LangText" />
            <Label>Voice</Label>
            <Entry x:Name="LangVoice" />
            <StackLayout Orientation="Horizontal">
                <Button x:Name="DelBtn" Text="Delete" Clicked="DelBtn_OnClicked" />
                <Button x:Name="CancelBtn" Text="Cancel" Clicked="CancelBtn_OnClicked" />
                <Button x:Name="OKBtn" Text="OK" Clicked="OKBtn_OnClicked"/>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>