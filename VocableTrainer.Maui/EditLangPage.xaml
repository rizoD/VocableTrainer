<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocableTrainer.Maui.EditLangPage"
             Title="EditLangPage">
	<ContentPage.Content>
		<StackLayout Grid.Row="0" BindingContext="{x:Static local:App.Data}">
			<Label>Language</Label>
			<Entry x:Name="LangText" Text="{Binding EditLanguage.Name}"/>
			<Label>Voice</Label>
			<Entry x:Name="LangVoice" Text="{Binding EditLanguage.Voice}"/>
			<StackLayout Orientation="Horizontal">
				<Button x:Name="DelBtn" Text="Delete" Clicked="DelBtn_OnClicked" />
			</StackLayout>
		</StackLayout>
	</ContentPage.Content>
</ContentPage>