<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VocableTrainer.Maui.MainPage"
			 xmlns:local ="clr-namespace:VocableTrainer.Maui" 
             Title="TrainingPage">

	<FlyoutPage.Flyout>
		<local:FlyoutMenuPage x:Name="flyoutPage" />
	</FlyoutPage.Flyout>
	<FlyoutPage.Detail>
		<NavigationPage>
			<x:Arguments>
				<local:TrainingPage />
			</x:Arguments>
		</NavigationPage>
	</FlyoutPage.Detail>
</FlyoutPage>